        function renderFavorit() {
            const favs = SafeStore.get('rapzzz_favs', []);
            const row = document.getElementById('favRow');
            if (!favs.length) { row.innerHTML = ''; return; }
            row.innerHTML = favs.map(v => {
                const [qty] = v.split('|');
                return `<span class="fav-chip" onclick="pilihFavorit('${v}')">⭐ ${qty} foll <span class="x" onclick="event.stopPropagation();hapusFavorit('${v}')">×</span></span>`;
            }).join('');
        }
        function simpanFavorit() {
            const sel = document.getElementById('layananSelect');
            if (!sel.value) return;
            const favs = SafeStore.get('rapzzz_favs', []);
            if (!favs.includes(sel.value)) {
                favs.unshift(sel.value);
                SafeStore.set('rapzzz_favs', favs.slice(0, 3));
                renderFavorit();
            }
        }
        function hapusFavorit(v) { SafeStore.set('rapzzz_favs', SafeStore.get('rapzzz_favs', []).filter(x => x !== v)); renderFavorit(); }
        function pilihFavorit(v) { document.getElementById('layananSelect').value = v; updateOrder(); }

        // ===== LACAK =====
        function lacakOrder() {
            const id = document.getElementById('trackInput').value.trim().toUpperCase();
            const res = document.getElementById('trackResult');
            if (!id) { res.className = 'track-result err show'; res.textContent = '❌ Masukkan Order ID dulu.'; return; }
            const riwayat = SafeStore.get('rapzzz_orders', []);
            const found = riwayat.find(o => o.orderId === id);
            if (!found) { res.className = 'track-result err show'; res.textContent = '❌ Order ID tidak ditemukan.'; return; }
            res.className = 'track-result ok show';
            res.innerHTML = `✅ <b>${found.orderId}</b><br>${found.jumlah} followers · ${formatRupiah(found.hargaNum)}<br>Status: <b>${found.status}</b><br>Waktu: ${new Date(found.waktu).toLocaleString('id-ID')}`;
        }

        // ===== UPDATE ORDER =====
        function updateOrder() {
            const selectElement = document.getElementById('layananSelect');
            const qrisSection = document.getElementById('qrisSection');
            const btnCek = document.getElementById('btnCekTF');
            const waButton = document.getElementById('waLink');
            const statusTF = document.getElementById('statusTF');
            const uploadSection = document.getElementById('uploadSection');
            const fileBukti = document.getElementById('fileBukti');
            const imgPreview = document.getElementById('imgPreview');
            const calcBox = document.getElementById('calcBox');

            btnCek.style.display = 'flex';
            btnCek.innerHTML = "Saya Sudah TF";
            applyStoreStatus();
            waButton.style.display = 'none'; statusTF.style.display = 'none'; statusTF.innerHTML = '';
            uploadSection.style.display = 'none'; fileBukti.value = ""; imgPreview.style.display = 'none'; imgPreview.src = '';
            document.getElementById('tracker').classList.remove('show');
            document.getElementById('estimasiBox').classList.remove('show');

            if (selectElement.value === "") { qrisSection.style.display = 'none'; calcBox.style.display = 'none'; resizeSlider(); return; }
            const qty = parseInt(selectElement.value.split('|')[0]);
            if (qty === 1000) { calcBox.style.display = 'block'; onCalcChange(); }
            else calcBox.style.display = 'none';

            qrisSection.style.display = 'block';
            applySelectedPrice();
            simpanFavorit();
            setTimeout(resizeSlider, 60);
        }

        // ===== PREVIEW =====
        function previewBukti(event) {
            const input = event.target;
            const imgPreview = document.getElementById('imgPreview');
            const btnCek = document.getElementById('btnCekTF');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imgPreview.src = e.target.result; imgPreview.style.display = 'block';
                    btnCek.innerHTML = "Verifikasi Sekarang";
                    setTimeout(() => { resizeSlider(); window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }); }, 100);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function generateOrderId() {
            const d = new Date();
            const ymd = `${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}`;
            const rnd = Math.random().toString(36).substring(2, 6).toUpperCase();
            return `RAPZ-${ymd}-${rnd}`;
        }

        function checkRateLimit() {
            const last = SafeStore.get('rapzzz_last_order', 0);
            const now = Date.now();
            if (now - last < 30000) {
                const remain = Math.ceil((30000 - (now - last)) / 1000);
                alert(`Tunggu ${remain} detik sebelum order lagi.`);
                return false;
            }
            return true;
        }

        // ===== MODE TUTUP =====
        function toggleStore() {
            const cur = SafeStore.get('rapzzz_store_open', true);
            SafeStore.set('rapzzz_store_open', !cur);
            applyStoreStatus();
        }
        function applyStoreStatus() {
            const isOpen = SafeStore.get('rapzzz_store_open', true);
            const btn = document.getElementById('storeStatus');
            const banner = document.getElementById('closedBanner');
            const btnCek = document.getElementById('btnCekTF');
            if (!btn) return;
            if (isOpen) {
                btn.className = 'store-status open';
                btn.textContent = '🟢 Buka';
                banner.classList.remove('show');
                if (btnCek && btnCek.style.display !== 'none') btnCek.disabled = false;
            } else {
                btn.className = 'store-status closed';
                btn.textContent = '🔴 Tutup';
                banner.classList.add('show');
                if (btnCek) btnCek.disabled = true;
            }
        }

        // ===== WA KONTEKSTUAL =====
        function waKontekstual(orderId, status, jumlah) {
            let msg = '';
            if (status === 'menunggu konfirmasi') {
                msg = `Halo Owner RAPZZZ STOREEE,\n\nSaya sudah transfer untuk order *${orderId}* (${jumlah} followers).\n\nBukti TF saya lampirkan di chat ini. Mohon dikonfirmasi ya min 🙏`;
            } else if (status === 'diproses') {
                msg = `Halo Owner RAPZZZ STOREEE,\n\nSaya mau tanya progress order *${orderId}* (${jumlah} followers).\n\nSudah sampai mana ya min? 🙏`;
            } else {
                msg = `Halo Owner RAPZZZ STOREEE,\n\nOrder *${orderId}* (${jumlah} followers) sudah selesai. Terima kasih!\n\nSaya mau order lagi.`;
            }
            return `https://wa.me/${NOMOR_OWNER}?text=${encodeURIComponent(msg)}`;
        }

        function simpanProviderId(orderId, val) {
            if (!val.trim()) return;
            const riwayat = SafeStore.get('rapzzz_orders', []);
            const idx = riwayat.findIndex(o => o.orderId === orderId);
            if (idx >= 0) {
                riwayat[idx].providerId = val.trim();
                SafeStore.set('rapzzz_orders', riwayat);
                alert('Provider ID disimpan: ' + val.trim());
            }
        }

        // ===== CEK PEMBAYARAN =====
        function cekPembayaranSuntik() {
            const isOpen = SafeStore.get('rapzzz_store_open', true);
            if (!isOpen) { alert("Toko sedang tutup. Coba lagi nanti ya."); return; }

            const hp = document.getElementById('hpField');
            if (hp && hp.value) return;
            if (!checkRateLimit()) return;

            const linkInput = document.getElementById('linkInput').value.trim();
            const btnCek = document.getElementById('btnCekTF');
            const waButton = document.getElementById('waLink');
            const statusTF = document.getElementById('statusTF');
            const fileInput = document.getElementById('fileBukti');
            const uploadSection = document.getElementById('uploadSection');
            const selectElement = document.getElementById('layananSelect');
            const appSelect = document.getElementById('appSelect').value;

            if (!selectElement.value) { alert("Pilih paket dulu!"); return; }
            if (!linkInput) { alert("Isi link saluran WhatsApp Anda dulu!"); return; }
            if (!WA_CHANNEL_REGEX.test(linkInput)) { alert("Format link salah. Contoh: https://whatsapp.com/channel/xxxxxxxx"); return; }
            if (uploadSection.style.display === 'none' || uploadSection.style.display === '') {
                uploadSection.style.display = 'block'; alert("Silakan upload screenshot bukti transfer!");
                setTimeout(resizeSlider, 60); return;
            }
            if (fileInput.files.length === 0) { alert("Bukti TF belum di-upload!"); return; }

            btnCek.innerHTML = "Memverifikasi ⏳"; btnCek.disabled = true;

            const [jumlahRaw, harga] = selectElement.value.split('|');
            let jumlah = parseInt(jumlahRaw);
            let hargaNum = parseInt(harga);
            if (selectElement.value === "1000|7000" && document.getElementById('calcBox').style.display === 'block') {
                jumlah = parseInt(document.getElementById('calcSlider').value);
                hargaNum = Math.round(jumlah * 7);
            }

            const orderId = generateOrderId();

            setTimeout(() => {
                btnCek.style.display = 'none';
                statusTF.style.display = 'block';
                statusTF.innerHTML = `✅ Order <b>${orderId}</b> dibuat.
                    <button class="btn-copy" onclick="copyOrderId('${orderId}', this)">Salin</button>
                    <br><span style="font-size:11px;color:#aaa;">Lanjut ke WhatsApp Owner ↓</span>`;
                waButton.style.display = 'flex';

                document.getElementById('tracker').classList.add('show');
                document.getElementById('step1').classList.add('done');
                document.getElementById('step2').classList.remove('done');
                document.getElementById('step3').classList.remove('done');
                document.getElementById('trackerFill').style.width = '33%';

                const riwayat = SafeStore.get('rapzzz_orders', []);
                riwayat.unshift({ orderId, jumlah, hargaNum, linkInput, app: appSelect, waktu: new Date().toISOString(), status: 'menunggu konfirmasi' });
                SafeStore.set('rapzzz_orders', riwayat.slice(0, 20));
                SafeStore.set('rapzzz_last_order', Date.now());

                const pesanWA = `Halo Owner RAPZZZ STOREEE,\n\n*Order ID*: ${orderId}\n📦 *Paket*: ${jumlah} Pengikut\n💰 *Total*: ${formatRupiah(hargaNum)}\n⏱️ *Estimasi Proses*: 3-5 menit\n🔗 *Link Saluran*: ${linkInput}\n📱 *App*: ${appSelect}\n\n⚠️ *Bukti transfer saya lampirkan di chat ini.* Mohon diproses ya min.`;
                const encodedPesan = encodeURIComponent(pesanWA);
                if (appSelect === 'wa') waButton.href = `https://wa.me/${NOMOR_OWNER}?text=${encodedPesan}`;
                else waButton.href = `whatsapp://send?phone=${NOMOR_OWNER}&text=${encodedPesan}`;

                renderRiwayat();
                requestNotifPermission();
                setTimeout(resizeSlider, 60);
            }, 1500);
        }

        function copyOrderId(orderId, btn) {
            navigator.clipboard.writeText(orderId).then(() => { btn.innerText = "Tersalin!"; setTimeout(() => btn.innerText = "Salin", 1500); })
            .catch(() => { alert("Order ID: " + orderId); });
        }

        // ===== RINGKASAN =====
        function renderSummary() {
            const riwayat = SafeStore.get('rapzzz_orders', []);
            const box = document.getElementById('summaryBox');
            if (!box) return;
            if (!riwayat.length) { box.classList.remove('show'); return; }
            const today = new Date().toISOString().slice(0,10);
            const todayOrders = riwayat.filter(o => o.waktu.slice(0,10) === today);
            const total = todayOrders.reduce((s, o) => s + (o.hargaNum || 0), 0);
            box.classList.add('show');
            box.innerHTML = `💰 Hari ini: <b>${formatRupiah(total)}</b> · ${todayOrders.length} order`;
        }

        // ===== RIWAYAT =====
        function renderRiwayat() {
            const box = document.getElementById('riwayatBox');
            const list = document.getElementById('riwayatList');
            const riwayat = SafeStore.get('rapzzz_orders', []);
            if (!riwayat.length) { box.style.display = 'none'; return; }
            box.style.display = 'block';
            const totalOrders = riwayat.length;

            list.innerHTML = riwayat.slice(0, 5).map((o, i) => {
                const loyal = totalOrders >= 3 ? '<span class="badge-loyal">⭐ Pelanggan Setia</span>' : '';
                const waLink = waKontekstual(o.orderId, o.status, o.jumlah);
                const waLabel = o.status === 'menunggu konfirmasi' ? '💬 Konfirmasi TF'
                              : o.status === 'diproses' ? '💬 Tanya Progress'
                              : '💬 Order Lagi';
                const providerVal = o.providerId || '';
                return `<div class="riwayat-item">
                    <b>${o.orderId}</b>${loyal} — ${o.jumlah} followers<br>
                    <span>${new Date(o.waktu).toLocaleString('id-ID')} · ${o.status}</span>
                    <br>
                    <a href="${waLink}" target="_blank" class="btn-wa-ctx">${waLabel}</a>
                    <button class="btn-order-lagi" onclick="orderLagi(${i})">Order Lagi</button>
                    <div class="provider-row">
                        <input type="text" placeholder="Provider ID (opsional)" value="${providerVal}" id="prov-${o.orderId}">
                        <button onclick="simpanProviderId('${o.orderId}', document.getElementById('prov-${o.orderId}').value)">Simpan</button>
                    </div>
                </div>`;
            }).join('');
            renderSummary();
            setTimeout(resizeSlider, 60);
        }

        function orderLagi(idx) {
            const riwayat = SafeStore.get('rapzzz_orders', []);
            const o = riwayat[idx];
            if (!o) return;
            switchTab(0);
            const sel = document.getElementById('layananSelect');
            const opt = [...sel.options].find(op => op.value && parseInt(op.value.split('|')[0]) === o.jumlah);
            if (opt) sel.value = opt.value;
            document.getElementById('linkInput').value = o.linkInput;
            validateLink(); updateOrder();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ===== TESTI =====
        function initTesti() {
            const data = [
                { name: "Andi", text: "Order 500 follower, masuk semua dalam 2 jam. Mantap!", stars: 5 },
                { name: "Sinta", text: "Murah, cepat, owner fast respon. Recommended banget.", stars: 5 },
                { name: "Budi", text: "Awalnya ragu, ternyata beneran nambah. Lanjut order lagi.", stars: 5 },
                { name: "Dewi", text: "Garansi beneran. Pas kurang dikit, langsung di-refill.", stars: 5 },
                { name: "Rina", text: "QRIS gampang, order cuma 5 menit udah beres.", stars: 4 },
                { name: "Fajar", text: "Saluran WA gue naik dari 200 ke 1500. Thanks min!", stars: 5 },
            ];
            const track = document.getElementById('testiTrack');
            const cards = data.map(d => `<div class="testi-card"><b>${d.name}</b> <span class="stars">${'★'.repeat(d.stars)}</span><br>${d.text}</div>`).join('');
            track.innerHTML = cards + cards;
        }

        // ===== MURID =====
        function orderMurid() {
            const pesan = encodeURIComponent(`Halo Owner RAPZZZ STOREEE,\n\nSaya mau mendaftar *OPEN MURID SUNTIK WA* dengan harga 10K.\n\nMohon diarahkan untuk langkah selanjutnya ya min. Terima kasih!`);
            window.open(`https://wa.me/${NOMOR_OWNER}?text=${pesan}`, '_blank');
        }

        function requestNotifPermission() {
            if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission();
        }

        // ===== INIT =====
        window.addEventListener('load', () => {
            initTheme();
            handleHash();
            tabBtns.forEach((btn, i) => btn.dataset.index = i);
            resizeSlider();
            renderRiwayat();
            renderFavorit();
            initLiveCounter();
            initTesti();
            requestNotifPermission();
            initQueue();
            applyStoreStatus();
        });
    </script>

</body>
</html>
