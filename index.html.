            if (store.date !== today) { base = 38 + Math.floor(Math.random() * 25); SafeStore.set('rapzzz_live', { date: today, count: base }); }
            else { base = store.count; }
            animateCounter(base);
            setInterval(() => {
                const s = SafeStore.get('rapzzz_live', { count: base });
                if (Math.random() < 0.35) { s.count = (s.count || base) + 1; SafeStore.set('rapzzz_live', s); animateCounter(s.count); }
            }, 18000);
        }
        function animateCounter(target) {
            const el = document.getElementById('liveCounterText');
            const start = parseInt(el.dataset.cur || 0);
            const dur = 700, t0 = performance.now();
            function step(t) {
                const p = Math.min((t - t0) / dur, 1);
                const val = Math.floor(start + (target - start) * p);
                el.textContent = `${val} order diproses hari ini`;
                el.dataset.cur = val;
                if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
